@@ -132,6 +132,17 @@ module pe_line (
   wire signed [20:0] m_q = q + 21'sd128;                         // one clock later
   wire signed [20:0] m_e = m_q - m_age;                          // the edge, from its expected time
   wire       m_in = (edge1 || edge2) && m_e >= -(mn < 6'd32 ? m_wide : m_win);
+  // NRZ/NRZI: the sample counter's load after a transition (P/2 - 1).
+`ifdef PE_LINE_NRZI_HALF
+  // PROPOSAL (docs/usb-full-speed.md, not in the signed-off chip): one clock
+  // shorter when the half-cycle sample already saw the edge, which centres the
+  // sample at 1.5-2.5 clocks after the edge instead of 2-3. USB full speed
+  // (P = 4 at 48 MHz): an edge-to-edge interval may shrink by 31 ns instead
+  // of 21 ns (spec: 18.5 ns).
+  wire [15:0] r_load = {1'b0, p[15:1]} - (edge1 ? 16'd2 : 16'd1);
